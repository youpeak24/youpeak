{
  "version": 2,
  "buildCommand": "cd admin/frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "admin/frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "functions/backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
