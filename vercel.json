{
  "buildCommand": "npm run build --prefix admin/frontend",
  "outputDirectory": "admin/frontend/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/functions/backend/index.js"
    },
    {
      "source": "/((?!api/|static/|manifest\\.json|favicon\\.ico|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}






